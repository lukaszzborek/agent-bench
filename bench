#!/usr/bin/env python3
"""bench — sandboxed agent benchmark CLI.

  bench list                                   tasks with dataset, agent, model, arms
  bench run <task>... [--arm A] [--exclude-arm A] [--exclude-task T] [--model [AGENT:]MODEL] [--effort E] [--reps N] [--jobs N] [--keep]
  bench report [path...]                       default: everything in results/
  bench publish [path...]                      merge results into site/data.json (GitHub Pages dashboard)
  bench judge [path...] [--model M] [--votes N] [--force]   LLM-as-judge checks on patches, writes judge.json
  bench build [claude|codex ...] [--tag T] [--deps "dotnet node"]

<task> = dataset (subdir of tasks/), task file name without .yaml, or a path to a yaml file.
"""
import argparse
import os
import random
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from pathlib import Path

import judge
from publish import publish
from report import report
from run_trial import HERE, load_tasks, resolve_repo, run_trial, slug


def cmd_list(a):
    for p in sorted((HERE / "tasks").rglob("*.yaml")):
        t = load_tasks(str(p))[0]
        print(f"{t['dataset']:10} {p.stem:40} {t['agent']:7} {t['model']:22} {t.get('template_tag', 'v1'):8} arms: {', '.join(t['arms'])}")


def model_variants(task: dict, models: list[str] | None, effort: str | None) -> list[dict]:
    """Copies of `task`, one per `[agent:]model` spec; the task's own agent/model when none given."""
    variants = []
    for spec in models or [None]:
        t = dict(task)
        if spec:
            agent, _, model = spec.rpartition(":")
            t["agent"], t["model"] = agent or t["agent"], model
        if effort:
            t["effort"] = effort
        variants.append(t)
    return variants


def cmd_run(a):
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    plan, run_dirs = [], []
    tasks = [v for ref in a.task for t in load_tasks(ref) if t["id"] not in (a.exclude_task or [])
             for v in model_variants(t, a.model, a.effort)]
    for task in tasks:
        # resolved here, serially, so parallel trials never race on the same clone
        task["repo_path"] = resolve_repo(task["repo"], task["commit"])
        arms = [arm for arm in a.arm or task["arms"] if arm in task["arms"] and arm not in (a.exclude_arm or [])]
        for arm in set(a.arm or []) - set(task["arms"]):
            print(f"skip {task['id']}: no arm {arm!r} (has {', '.join(task['arms'])})", file=sys.stderr)
        tag = a.template_tag or os.environ.get("TAG") or task.get("template_tag", "v1")
        run_dir = Path(a.out) / slug(f"{task['id']}-{task['agent']}-{task['model']}-{ts}")
        run_dirs.append(run_dir)
        plan += [(task, arm, rep, run_dir, tag, a.keep) for arm in arms for rep in range(1, a.reps + 1)]
    if not plan:
        sys.exit("nothing to run")
    random.shuffle(plan)  # interleave arms so time-of-day and API cache effects do not favour one arm

    with ThreadPoolExecutor(a.jobs) as pool:
        futures = [pool.submit(run_trial, *trial) for trial in plan]
        start, failed = time.monotonic(), 0
        try:
            for done, f in enumerate(as_completed(futures), 1):
                meta = f.result()
                failed += bool(meta.get("error") or meta.get("grade_exit"))
                elapsed = time.monotonic() - start
                eta = elapsed / done * (len(plan) - done)
                print(f"== {done}/{len(plan)} done, {failed} failed, {len(plan) - done} left, "
                      f"elapsed {elapsed / 60:.0f} min, eta {eta / 60:.0f} min")
        except KeyboardInterrupt:
            # running sbx children get the SIGINT too, so their trials fail and clean up on their own
            pool.shutdown(cancel_futures=True)
    if len(plan) > 1:
        report(run_dirs)


def cmd_report(a):
    report([Path(p) for p in a.path] or [HERE / "results"])


def cmd_publish(a):
    publish([Path(p) for p in a.path] or [HERE / "results"], HERE / "site" / "data.json")


def cmd_judge(a):
    judge.run([Path(p) for p in a.path] or [HERE / "results"], a.model, a.votes, a.force)


def cmd_build(a):
    env = {**os.environ, **({"TAG": a.tag} if a.tag else {}), **({"DEPS": a.deps} if a.deps else {})}
    sys.exit(subprocess.run([str(HERE / "build-templates.sh"), *a.agent], env=env).returncode)


def main():
    ap = argparse.ArgumentParser(prog="bench", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="list tasks").set_defaults(fn=cmd_list)

    p = sub.add_parser("run", help="run arms x reps for one or more tasks, shuffled, one sandbox per trial")
    p.add_argument("task", nargs="+", help="dataset or task name from tasks/, or path to a yaml file")
    p.add_argument("--arm", action="append", help="key from the task's arms: block, repeatable (default: all arms)")
    p.add_argument("--exclude-arm", action="append", metavar="ARM", help="arm to skip, repeatable")
    p.add_argument("--exclude-task", action="append", metavar="TASK", help="task id to skip, repeatable")
    p.add_argument("--reps", type=int, default=1, help="trials per arm, each in its own sandbox")
    p.add_argument("--jobs", type=int, default=1, help="sandboxes running at once; >1 skews wall_s, keep 1 when timing matters")
    p.add_argument("--keep", action="store_true", help="do not remove the sandboxes afterwards")
    p.add_argument("--out", default=str(HERE / "results"))
    p.add_argument("--template-tag", help="overrides the task's template_tag (default v1)")
    p.add_argument("--model", action="append", metavar="[AGENT:]MODEL",
                   help="override the task's model, repeatable = one full plan per model; e.g. claude-opus-5-5, "
                        "codex:gpt-5.3-codex (AGENT defaults to the task's agent)")
    p.add_argument("--effort", help="override the task's effort (claude: low|medium|high, codex: minimal..xhigh)")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("report", help="table + per-arm medians")
    p.add_argument("path", nargs="*", help="results dir or run dir(s) (default: results/)")
    p.set_defaults(fn=cmd_report)

    p = sub.add_parser("publish", help="merge results into site/data.json for the GitHub Pages dashboard")
    p.add_argument("path", nargs="*", help="results dir or run dir(s) (default: results/)")
    p.set_defaults(fn=cmd_publish)

    p = sub.add_parser("judge", help="LLM-as-judge yes/no checks on each trial's patch (host claude CLI)")
    p.add_argument("path", nargs="*", help="results dir, run dir(s) or trial dir(s) (default: results/)")
    # a different model than the agents', so the judge does not grade its own style
    p.add_argument("--model", default="claude-opus-5-5")
    p.add_argument("--votes", type=int, default=3, help="judge calls per trial, majority per check")
    p.add_argument("--force", action="store_true", help="judge again even if judge.json exists")
    p.set_defaults(fn=cmd_judge)

    p = sub.add_parser("build", help="build sandbox templates (wraps build-templates.sh)")
    p.add_argument("agent", nargs="*", choices=["claude", "codex"], help="default: both")
    p.add_argument("--tag", help="image tag (default v1)")
    p.add_argument("--deps", help='space-separated scripts from templates/deps, e.g. "dotnet node"')
    p.set_defaults(fn=cmd_build)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
