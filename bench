#!/usr/bin/env python3
"""bench — sandboxed agent benchmark CLI.

  bench list                                   tasks with dataset, agent, model, arms
  bench run <task>... [--arm A] [--reps N] [--jobs N] [--keep]
  bench report [path...]                       default: everything in results/
  bench build [claude|codex ...] [--tag T] [--deps "dotnet node"]

<task> = dataset (subdir of tasks/), task file name without .yaml, or a path to a yaml file.
"""
import argparse
import os
import random
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from pathlib import Path

from report import report
from run_trial import HERE, load_tasks, resolve_repo, run_trial


def cmd_list(a):
    tasks = HERE / "tasks"
    for p in sorted(tasks.rglob("*.yaml")):
        t = load_tasks(str(p))[0]
        dataset = p.parent.name if p.parent != tasks else "-"
        print(f"{dataset:10} {p.stem:36} {t['agent']:7} {t['model']:22} {t.get('template_tag', 'v1'):8} arms: {', '.join(t.get('arms', {}))}")


def cmd_run(a):
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    plan, run_dirs = [], []
    for task in (t for ref in a.task for t in load_tasks(ref)):
        # resolved here, serially, so parallel trials never race on the same clone
        task["repo_path"] = resolve_repo(task["repo"], task["commit"])
        arms = a.arm or list(task.get("arms", {}))
        for arm in arms:
            if arm not in task.get("arms", {}):
                sys.exit(f"arm {arm!r} not in {task['id']} arms {list(task.get('arms', {}))}")
        tag = a.template_tag or os.environ.get("TAG") or task.get("template_tag", "v1")
        run_dir = Path(a.out) / f"{task['id']}-{task['agent']}-{ts}".lower()
        run_dirs.append(run_dir)
        plan += [(task, arm, rep, run_dir, tag, a.keep) for arm in arms for rep in range(1, a.reps + 1)]
    random.shuffle(plan)  # interleave arms so time-of-day and API cache effects do not favour one arm

    with ThreadPoolExecutor(a.jobs) as pool:
        futures = [pool.submit(run_trial, *trial) for trial in plan]
        try:
            for f in as_completed(futures):
                f.result()
        except KeyboardInterrupt:
            # running sbx children get the SIGINT too, so their trials fail and clean up on their own
            pool.shutdown(cancel_futures=True)
    if len(plan) > 1:
        report(run_dirs)


def cmd_report(a):
    report([Path(p) for p in a.path] or [HERE / "results"])


def cmd_build(a):
    env = {**os.environ, **({"TAG": a.tag} if a.tag else {}), **({"DEPS": a.deps} if a.deps else {})}
    sys.exit(subprocess.run([str(HERE / "build-templates.sh"), *a.agent], env=env).returncode)


def main():
    ap = argparse.ArgumentParser(prog="bench", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="list tasks").set_defaults(fn=cmd_list)

    p = sub.add_parser("run", help="run arms x reps for one or more tasks, shuffled, one sandbox per trial")
    p.add_argument("task", nargs="+", help="dataset or task name from tasks/, or path to a yaml file")
    p.add_argument("--arm", action="append", help="key from the task's arms: block, repeatable (default: all arms)")
    p.add_argument("--reps", type=int, default=1, help="trials per arm, each in its own sandbox")
    p.add_argument("--jobs", type=int, default=1, help="sandboxes running at once; >1 skews wall_s, keep 1 when timing matters")
    p.add_argument("--keep", action="store_true", help="do not remove the sandboxes afterwards")
    p.add_argument("--out", default=str(HERE / "results"))
    p.add_argument("--template-tag", help="overrides the task's template_tag (default v1)")
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("report", help="table + per-arm medians")
    p.add_argument("path", nargs="*", help="results dir or run dir(s) (default: results/)")
    p.set_defaults(fn=cmd_report)

    p = sub.add_parser("build", help="build sandbox templates (wraps build-templates.sh)")
    p.add_argument("agent", nargs="*", choices=["claude", "codex"], help="default: both")
    p.add_argument("--tag", help="image tag (default v1)")
    p.add_argument("--deps", help='space-separated scripts from templates/deps, e.g. "dotnet node"')
    p.set_defaults(fn=cmd_build)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
